              <td>s</td>
            </tr>
            <tr>
              <td>Coordonată</td>
              <td>\(x,y,z\)</td>
              <td>Poziția pe fiecare axă</td>
              <td>m</td>
            </tr>
            <tr>
              <td>Vector de poziție</td>
              <td>\(\vec r\)</td>
              <td>Poziția punctului față de origine</td>
              <td>m</td>
            </tr>
            <tr>
              <td>Drum parcurs</td>
              <td>\(s\)</td>
              <td>Lungimea porțiunii de traiectorie</td>
              <td>m</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>


