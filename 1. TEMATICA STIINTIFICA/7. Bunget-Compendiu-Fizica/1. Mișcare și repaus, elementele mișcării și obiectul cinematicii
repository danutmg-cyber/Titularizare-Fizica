  <script>
    /* -----------------------------------------
       THEME
    ----------------------------------------- */

    const body = document.body;
    const themeToggle = document.getElementById('themeToggle');

    const storedTheme = localStorage.getItem('vectorTheme');

    if (storedTheme === 'dark') {
      body.classList.add('dark');
    }

    themeToggle.addEventListener('click', () => {
      body.classList.toggle('dark');

      localStorage.setItem(
        'vectorTheme',
        body.classList.contains('dark') ? 'dark' : 'light'
      );
    });


    /* -----------------------------------------
       FONT SIZE
    ----------------------------------------- */

    let fontScale =
      parseFloat(localStorage.getItem('vectorFontScale')) || 1;

    function applyFontScale() {
      document.documentElement.style
        .setProperty('--font-scale', fontScale);

      localStorage.setItem(
        'vectorFontScale',
        String(fontScale)
      );
    }

    applyFontScale();

    document.getElementById('fontUp')
      .addEventListener('click', () => {
        fontScale = Math.min(1.3, fontScale + 0.05);
        applyFontScale();
      });

    document.getElementById('fontDown')
      .addEventListener('click', () => {
        fontScale = Math.max(0.85, fontScale - 0.05);
        applyFontScale();
      });


    /* -----------------------------------------
       READING PROGRESS
    ----------------------------------------- */

    const progress = document.getElementById('readingProgress');

    window.addEventListener('scroll', () => {
      const scrollTop =
        document.documentElement.scrollTop || document.body.scrollTop;

      const scrollHeight =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;

      const percentage =
        scrollHeight > 0
          ? (scrollTop / scrollHeight) * 100
          : 0;

      progress.style.width = percentage + '%';
    });


    /* -----------------------------------------
       FLASHCARDS
    ----------------------------------------- */

    document.querySelectorAll('.flashcard')
      .forEach(card => {
        card.addEventListener('click', () => {
          card.classList.toggle('flipped');
        });
      });


    /* -----------------------------------------
       MOTION LAB
    ----------------------------------------- */

    const trajectorySelect =
      document.getElementById('trajectorySelect');

    const timeSlider =
      document.getElementById('timeSlider');

    const timeValue =
      document.getElementById('timeValue');

    const movingPoint =
      document.getElementById('movingPoint');

    const positionVector =
      document.getElementById('positionVector');

    const trajectoryPath =
      document.getElementById('trajectoryPath');

    const pointLabel =
      document.getElementById('pointLabel');

    const xReadout =
      document.getElementById('xReadout');

    const yReadout =
      document.getElementById('yReadout');

    const rReadout =
      document.getElementById('rReadout');


    const origin = {
      x: 60,
      y: 330
    };


    function physicalCoordinates(type, t) {

      if (type === 'line') {
        return {
          x: 0.5 + 0.85 * t,
          y: 1.5 + 0.16 * t
        };
      }

      if (type === 'circle') {
        const angle = 0.6 * t;

        return {
          x: 5 + 3.2 * Math.cos(angle),
          y: 4 + 3.2 * Math.sin(angle)
        };
      }

      return {
        x: 0.8 * t,
        y: 0.08 * Math.pow(t - 5, 2) + 1.2
      };
    }


    function toSvg(p) {
      return {
        x: origin.x + p.x * 60,
        y: origin.y - p.y * 38
      };
    }


    function buildTrajectory(type) {

      let d = '';

      for (let i = 0; i <= 200; i++) {

        const t = 10 * i / 200;
        const physical = physicalCoordinates(type, t);
        const point = toSvg(physical);

        d +=
          (i === 0 ? 'M' : 'L') +
          point.x.toFixed(2) + ',' +
          point.y.toFixed(2) + ' ';
      }

      trajectoryPath.setAttribute('d', d);
    }


    function updateMotion() {

      const type = trajectorySelect.value;
      const t = parseFloat(timeSlider.value);

      const physical =
        physicalCoordinates(type, t);

      const point =
        toSvg(physical);

      movingPoint.setAttribute('cx', point.x);
      movingPoint.setAttribute('cy', point.y);

      pointLabel.setAttribute('x', point.x + 14);
      pointLabel.setAttribute('y', point.y - 12);

      positionVector.setAttribute('x2', point.x);
      positionVector.setAttribute('y2', point.y);

      const r =
        Math.sqrt(
          physical.x * physical.x +
          physical.y * physical.y
        );

      timeValue.textContent =
        t.toFixed(2) + ' s';

      xReadout.textContent =
        'x = ' + physical.x.toFixed(2);

      yReadout.textContent =
        'y = ' + physical.y.toFixed(2);

      rReadout.textContent =
        '|r| = ' + r.toFixed(2);

      buildTrajectory(type);
    }


    trajectorySelect
      .addEventListener('change', updateMotion);

    timeSlider
      .addEventListener('input', updateMotion);

    updateMotion();


    /* -----------------------------------------
       QUIZ
    ----------------------------------------- */

    const answers = {
      q1: 'b',
      q2: 'b',
      q3: 'b',
      q4: 'a',
      q5: 'b'
    };

    document.getElementById('gradeQuiz')
      .addEventListener('click', () => {

        let correct = 0;
        let answered = 0;

        Object.entries(answers)
          .forEach(([question, expected]) => {

            const selected =
              document.querySelector(
                `input[name="${question}"]:checked`
              );

            if (selected) {
              answered++;

              if (selected.value === expected) {
                correct++;
              }
            }
          });

        const score = correct * 2;

        const result =
          document.getElementById('quizResult');

        let message =
          `Ai răspuns la ${answered}/5 itemi. ` +
          `Punctaj: ${score}/10. `;

        if (score >= 9) {
          message +=
            'Foarte bine. Poți trece la viteza și accelerația.';
        } else if (score >= 7) {
          message +=
            'Nivel bun, dar reia definițiile unde ai ezitat.';
        } else {
          message +=
            'Reia secțiunile Mișcare și repaus și Elementele mișcării.';
        }

        result.textContent = message;

        result.className =
          score >= 7
            ? 'score-box correct'
            : 'score-box incorrect';

        localStorage.setItem(
          'vectorQuiz01',
          String(score)
        );
      });


    document.getElementById('resetQuiz')
      .addEventListener('click', () => {

        const result =
          document.getElementById('quizResult');

        result.textContent =
          'Punctajul va apărea aici.';

        result.className =
          'score-box';
      });


    /* -----------------------------------------
       CHECKLIST PERSISTENCE
    ----------------------------------------- */

    const checks =
      document.querySelectorAll('.checklist input');

    checks.forEach((check, index) => {

      const key =
        'vectorLesson01Check' + index;

      check.checked =
        localStorage.getItem(key) === 'true';

      check.addEventListener('change', () => {
        localStorage.setItem(
          key,
          String(check.checked)
        );
      });
    });

  </script>
